<?xml version="1.0" encoding="utf-8"?>
<!--
  The server is expected to be reached over plain http:// on the LAN, so cleartext
  traffic is allowed everywhere; user-installed certificates are trusted too, which
  lets a self-signed HTTPS server work.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
